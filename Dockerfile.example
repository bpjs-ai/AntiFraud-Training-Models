# Gunakan base image Ubuntu 20.04
FROM ubuntu:20.04

# Hindari prompt interaktif dan set locale/timezone
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Jakarta \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Install dependensi sistem dasar
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    gnupg \
    ca-certificates \
    wget \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Tambahkan PPA untuk Python 3.11
RUN add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-distutils \
    build-essential \
    libssl-dev \
    libffi-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgeos-dev \
    ccache \
    git \
    libzbar0 \
    && rm -rf /var/lib/apt/lists/*

# Install pip untuk Python 3.11 (karena dari deadsnakes tidak otomatis ada)
RUN wget https://bootstrap.pypa.io/get-pip.py && \
    python3.11 get-pip.py && \
    rm get-pip.py

# Setelah pip terinstall, baru upgrade pip, setuptools, wheel
RUN python3.11 -m pip install --no-cache-dir --upgrade pip setuptools wheel


# Arahkan python3 ke python3.11
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Set working directory
WORKDIR /app

# Copy requirements.txt dan install dependencies
COPY backend/classifier_service/requirements.txt .
RUN python3 -m pip install --no-cache-dir --timeout=300 -r requirements.txt

# Copy seluruh source code
COPY backend/classifier_service .

# Perbaikan path untuk qrdet .model
RUN QRDET_MODEL_PATH=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/qrdet/.model && \
    rm -rf "$QRDET_MODEL_PATH" && \
    mkdir -p "$QRDET_MODEL_PATH" && \
    chmod -R 777 "$QRDET_MODEL_PATH"

# Buat user non-root
RUN useradd -m -s /bin/bash appuser && \
    echo 'appuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Buat direktori yang dibutuhkan & beri izin
RUN mkdir -p \
        /home/appuser/.config/Ultralytics \
        /app/Data \
        /app/Result \
        /app/models \
        /app/temp && \
    SITE_PACKAGES_PATH=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])') && \
    chown -R appuser:appuser /home/appuser /app "$SITE_PACKAGES_PATH"

# Gunakan user non-root
USER appuser

# Expose port untuk FastAPI
EXPOSE 8050

# Jalankan aplikasi
CMD ["uvicorn", "run_optimized:app", "--host", "0.0.0.0", "--workers", "1", "--port", "8050", "--loop", "asyncio"]