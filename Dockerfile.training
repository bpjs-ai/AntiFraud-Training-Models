# Multi-stage Dockerfile untuk BPJS AntiFraud Training dengan PyTorch GPU

# ---- Stage 1: Dependencies ----
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime AS dependencies

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/root/.cache/huggingface \
    TORCH_HOME=/root/.cache/torch

WORKDIR /app

# System dependencies for OpenCV/Paddle runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libxrender1 \
    libxext6 \
    libsm6 \
    libgomp1 \
    ccache \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt ./
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# ---- Stage 2: Model Caching (Optional) ----
FROM dependencies AS model-cache

# Pre-download models to cache layer
RUN python -c "from transformers import AutoModel; AutoModel.from_pretrained('indobenchmark/indobert-base-p2')" && \
    python -c "from torchvision.models import resnet50, ResNet50_Weights; resnet50(weights=ResNet50_Weights.IMAGENET1K_V1)"

# ---- Stage 3: Runtime ----
FROM model-cache AS runtime

WORKDIR /app

# Copy application code
COPY . .

# Health check untuk memastikan CUDA available
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import torch; print('CUDA available:', torch.cuda.is_available())" || exit 1

# Default command untuk training
CMD ["python", "main.py", "--pipeline", "classifier", "--dataset-dir", "/app/dataset", "--output_dir", "/app/outputs"]

# Labels
LABEL maintainer="BPJS AntiFraud" \
      version="1.0.0" \
      description="BPJS AntiFraud Training Models with PyTorch GPU Support"
