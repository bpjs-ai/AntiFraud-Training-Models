# BPJS AntiFraud Training Models - Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# S3 Configuration
# =============================================================================
# Your S3 bucket name
S3_BUCKET_NAME=your-bucket-name

# S3 endpoint URL (for custom S3-compatible storage)
S3_ENDPOINT=your-s3-endpoint

# AWS credentials
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Dataset prefixes in S3
S3_CLASSIFIER_PREFIX=dataset/classifier/
S3_SIGNATURE_PREFIX=dataset/signature/

# =============================================================================
# Training Configuration
# =============================================================================
# Classifier training config
CLASSIFIER_CONFIG=config/classifier_config.json

# Signature detection training config
SIGNATURE_WORKSPACE=signature-detection
SIGNATURE_PROJECT=signature-detection-hlx8j-mem1d
SIGNATURE_VERSION=3
SIGNATURE_EPOCHS=70

# =============================================================================
# Docker Configuration
# =============================================================================
# GPU configuration (for NVIDIA GPUs)
CUDA_VISIBLE_DEVICES=0

# Memory limits (optional)
MEMORY_LIMIT=8G
CPU_LIMIT=4.0

# =============================================================================
# Development Configuration
# =============================================================================
# Enable debug mode
DEBUG=false

# Log level
LOG_LEVEL=INFO

# Jupyter notebook port (for development)
JUPYTER_PORT=8888
